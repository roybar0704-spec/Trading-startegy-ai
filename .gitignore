/data/*
# B-1/D-067/C3: keep the run registry directory in git (runs.jsonl itself stays
# untracked -- it's a local, append-only log, not a versioned artifact).
!/data/registry
/data/registry/*
!/data/registry/.gitkeep
benchmarks/_scratch_ticks/
*.parquet
*.duckdb
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
*.egg-info/
dist/
build/
.env
